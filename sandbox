#!/usr/bin/env bash
# Claude agent sandbox — one Lima VM per project.
#
#   sandbox new                      interactive setup: name, identities, tokens, VM, keys
#   sandbox ls                       list all sandbox VMs
#   sandbox agents                   list the agents this launcher knows about
#   sandbox secret set  <name>       store a token in the macOS Keychain
#   sandbox secret rm   <name>       remove a stored token
#   sandbox <project>                start (if needed) and open the project's default agent
#   sandbox <project> <agent>        open a specific agent (claude, opencode, ...)
#   sandbox <project> agent          list agents and whether they're installed in the VM
#   sandbox <project> agent install <name>        install an agent into the VM
#   sandbox <project> agent default <name>        set the project's default agent
#   sandbox <project> agent run <name> [args...]  run an agent (works even if its
#                                                 name collides with a command)
#   sandbox <project> daemon         background daemons (e.g. `claude remote-control`):
#                                    ls | status | logs [-f] | start | stop | restart | install | off
#   sandbox <project> shell          interactive shell in the VM
#   sandbox <project> code [path]    open VS Code (Remote-SSH) in the VM
#   sandbox <project> up             create/start the VM (auto-applies identities)
#   sandbox <project> auth           (re)apply GitHub identities/tokens from config
#   sandbox <project> secret [<user|keychain-name>]
#                                    replace a token (e.g. an expired PAT), then auth + audit
#   sandbox <project> keys           ensure GPG signing key, add to GitHub, verify
#   sandbox <project> set-email <email>  change the git email (regenerates GPG signing key)
#   sandbox <project> rename <new>   rename the project: config, VM and Keychain items
#   sandbox <project> migrate        rename a legacy claude-<project> VM to ai-sandbox-<project>
#   sandbox <project> session [ls]   list the Claude sessions in the VM
#   sandbox <project> session copy <id|--all> <other-project>
#                                    copy Claude sessions into another project's VM
#   sandbox <project> session export <id|--all> [file|-]
#                                    write Claude sessions to a file (or stdout)
#   sandbox <project> session import <file|-> [--no-register]
#                                    load an export, e.g. one made on another machine
#   sandbox <project> session register <id...|--all> [--running]
#                                    list sessions in the agent view (`claude agents`)
#   sandbox <project> config [--edit]    show (or edit) the project's config file
#   sandbox <project> audit          report which GitHub credential the VM holds
#   sandbox <project> exec CMD...    run a command in the VM
#   sandbox <project> status         show the VM status
#   sandbox <project> stop           stop the VM (disk kept)
#   sandbox <project> destroy        delete the VM and everything in it
#
# Project identities live in projects/<project>.conf; tokens live in the macOS
# Keychain, never in the repo. `sandbox new` writes the config for you.
#
# Agents (Claude Code, OpenCode, ...) are described by agents/<name>.conf and
# installed into the VM on first use — adding one is a new file, nothing here.
#
# Security note: the agent inside a VM runs with --dangerously-skip-permissions,
# so the VM is untrusted by construction. Nothing from the host is mounted into
# it, and anything the VM sends back to the host is validated here before use.
set -euo pipefail

# Data (agents/, projects/, lima/) lives next to this script, wherever the repo
# is checked out — resolve through symlinks so a PATH symlink still finds it.
ROOT="${AI_SANDBOX_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)}"
TEMPLATE="$ROOT/lima/claude.yaml"
HELPER_SRC="$ROOT/lima/cred-helper.sh"
PROJECTS="$ROOT/projects"
AGENTS="$ROOT/agents"
PREFIX="ai-sandbox-"
LEGACY_PREFIX="claude-"    # VMs created before the rename; still used until migrated
KC_PREFIX="ai-sandbox"     # Keychain service prefix
DEFAULT_AGENT="claude"

# Commands are matched before the agent registry, so these names can never
# resolve to an agent; `sandbox agents` warns if one is shadowed.
BUILTIN_CMDS="up start auth keys set-email email rename mv migrate session sessions shell code exec stop destroy delete status agent daemon daemons config conf audit secret token"

die() { echo "sandbox: $*" >&2; exit 1; }
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
is_builtin() { case " $BUILTIN_CMDS " in *" $1 "*) return 0 ;; esac; return 1; }
# Matched before the project name in the top-level dispatch — a project named
# after one of these could never be reached again.
TOPLEVEL_CMDS="new ls list agents secret help"
is_toplevel() { case " $TOPLEVEL_CMDS " in *" $1 "*) return 0 ;; esac; return 1; }

# --------------------------------------------------------------- validation
# Values from the wizard, the CLI and *.conf all end up either in a file that is
# later `source`d as shell code or in a path handed to another program, so they
# are validated at the door rather than escaped at each use site.
valid_ident()  { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$1" != *".."* ]]; }
valid_ghuser() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]]; }
valid_email()  { [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,}$ ]]; }
valid_host()   { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]; }
# <host>/<org>, optionally deeper (<host>/<org>/<repo>) — cred-helper.sh
# routes on the longest matching prefix, so deeper scopes are legal.
valid_scope()  { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(/[A-Za-z0-9._-]+)+$ ]]; }
# Free text (commit name): anything but control characters — it is single-quoted
# when written to the config.
valid_text()   { [ -n "$1" ] && [[ "$1" != *[[:cntrl:]]* ]]; }

# Single-quote a value for safe embedding in a config file that gets `source`d.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# ------------------------------------------------------------------ secrets
kc_service() { echo "${KC_PREFIX}:$1"; }
secret_get() { security find-generic-password -s "$(kc_service "$1")" -a "$USER" -w 2>/dev/null; }
secret_rm()  { security delete-generic-password -s "$(kc_service "$1")" -a "$USER" >/dev/null && echo ">> removed"; }
# Store a token WITHOUT ever putting it in argv: `security` prompts on the tty
# when -w is given no value. Passing the token as an argument would expose it to
# any process running as this user (`ps`) — exactly the threat the Keychain is
# there to reduce.
secret_put() {
    local name="$1" svc check; svc="$(kc_service "$name")"
    security add-generic-password -U -s "$svc" -a "$USER" -w || die "keychain write failed for $svc"
    check="$(secret_get "$name" || true)"
    [ -n "$check" ] || die "nothing stored for $svc (empty token?)"
}
secret_set() { # interactive: `security` prompts (hidden), then stores
    local name="$1"
    valid_ident "$name" || die "invalid secret name '$name' — use letters, digits, '.', '_', '-'"
    echo "Token for \"$name\" — 'security' will prompt for it (hidden, never on the command line)." >&2
    secret_put "$name"
    echo ">> stored in Keychain as $(kc_service "$name")"
}

# ------------------------------------------------------- project identity DSL
# projects/<name>.conf calls add_identity; records collected in $_IDENTITIES,
# one line per identity with fields in this order:
#   github_username | git_name | git_email | github_host | keychain | org_scopes
# The separator is US (0x1f), not TAB: tab counts as IFS whitespace, so `read`
# would collapse two adjacent tabs into one and shift every later field of an
# identity that omits --git-name or --git-email — silently pointing the Keychain
# lookup and `gh auth login --hostname` at the wrong values.
_IFS_REC=$'\037'
_IDENTITIES=""
add_identity() {
    local ghuser="" gname="" gemail="" ghost="github.com" kc="" scopes="" s
    while [ $# -gt 0 ]; do
        case "$1" in
            --github-username) ghuser="$2"; shift 2 ;;
            --git-name)        gname="$2";  shift 2 ;;
            --git-email)       gemail="$2"; shift 2 ;;
            --github-host)     ghost="$2";  shift 2 ;;
            --token-keychain)  kc="$2";     shift 2 ;;
            --org-scope)       scopes="$scopes $2"; shift 2 ;;
            *) die "add_identity: unknown arg '$1'" ;;
        esac
    done
    [ -n "$ghuser" ] || die "add_identity: --github-username required"
    [ -n "$kc" ]     || die "add_identity ($ghuser): --token-keychain required"
    # A hand-edited config is still shell code, but these values are also spliced
    # into paths and remote commands — keep them boring.
    valid_ghuser "$ghuser" || die "add_identity: invalid --github-username '$ghuser'"
    valid_ident  "$kc"     || die "add_identity ($ghuser): invalid --token-keychain '$kc'"
    valid_host   "$ghost"  || die "add_identity ($ghuser): invalid --github-host '$ghost'"
    [ -z "$gname" ]  || valid_text  "$gname"  || die "add_identity ($ghuser): invalid --git-name"
    [ -z "$gemail" ] || valid_email "$gemail" || die "add_identity ($ghuser): invalid --git-email '$gemail'"
    for s in $scopes; do
        valid_scope "$s" || die "add_identity ($ghuser): invalid --org-scope '$s' (expected <host>/<org>[/...])"
    done
    _IDENTITIES="${_IDENTITIES}${ghuser}${_IFS_REC}${gname}${_IFS_REC}${gemail}${_IFS_REC}${ghost}${_IFS_REC}${kc}${_IFS_REC}${scopes}
"
}
# projects/<name>.conf may also call `use_agent <name>` to pick the agent that
# a bare `sandbox <project>` opens. Absent => DEFAULT_AGENT.
_AGENT=""
use_agent() { _AGENT="$1"; }

# ...and `use_daemon <agent>` (repeatable) to pick which agents' background
# daemons the VM keeps running with nobody attached. Absent => the project's
# own agent, if it declares one; `use_daemon none` turns them off.
_DAEMONS=""
use_daemon() { _DAEMONS="$_DAEMONS $1"; }

# Resolve a path to the file it finally points at. The checks below must apply
# to what actually gets sourced, not to a symlink standing in front of it:
# `find` does not follow links (-P is the default) and a macOS symlink is 0755,
# so checking the link itself would happily wave through a world-writable
# target. Resolving also means we source the real path, closing the gap between
# the check and the `source`.
resolve_path() {
    local f="$1" t d i=0
    d="$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)" || return 1
    f="$d/$(basename "$f")"
    while [ -L "$f" ]; do
        i=$((i+1)); [ "$i" -le 20 ] || return 1     # symlink loop
        t="$(readlink "$f")" || return 1
        case "$t" in /*) ;; *) t="$(dirname "$f")/$t" ;; esac
        d="$(cd "$(dirname "$t")" 2>/dev/null && pwd -P)" || return 1
        f="$d/$(basename "$t")"
    done
    printf '%s' "$f"
}

# A project config is shell code that this script executes. Refuse to run one
# that anybody but the owner can modify.
check_conf_perms() {
    # `find` rather than `stat`: the two stat dialects disagree on -f/-c and the
    # wrong one silently succeeds with garbage.
    local f="$1"
    if [ -z "$(find "$f" -maxdepth 0 -user "$(id -un)" 2>/dev/null)" ]; then
        die "$f is not owned by you — refusing to source it"
    fi
    if [ -n "$(find "$f" -maxdepth 0 \( -perm -g+w -o -perm -o+w \) 2>/dev/null)" ]; then
        die "$f is group/world-writable and is executed as shell code — run: chmod 600 $f"
    fi
}
# Echo the vetted, fully-resolved path of a project config, or die.
conf_path() {
    local f="$1" real
    real="$(resolve_path "$f")" || die "cannot resolve $f (symlink loop?)"
    [ -f "$real" ] || die "$f does not point at a regular file"
    check_conf_perms "$real"
    printf '%s' "$real"
}
load_project() {
    _IDENTITIES=""; _AGENT=""; _DAEMONS=""
    local f="$PROJECTS/$1.conf" real
    [ -f "$f" ] || return 0
    real="$(conf_path "$f")" || exit 1
    # shellcheck source=/dev/null
    source "$real"
}
primary_record() { printf '%s' "$_IDENTITIES" | sed -n '1p'; }
project_agent() { load_project "$1"; printf '%s' "${_AGENT:-$DEFAULT_AGENT}"; }

# --------------------------------------------------------------- agent registry
# agents/<name>.conf declares how to install and launch one coding agent.
# Values are run inside the VM, so '$HOME' must stay single-quoted in the conf —
# it is expanded by the VM's shell, not here.
_A_DESC=""; _A_BIN=""; _A_PATHS=""; _A_INSTALL=""; _A_SETUP=""; _A_LAUNCH=""; _A_DAEMON=""
agent_desc()    { _A_DESC="$1"; }
agent_bin()     { _A_BIN="$1"; }
agent_path()    { _A_PATHS="$_A_PATHS $1"; }
agent_install() { _A_INSTALL="$1"; }
agent_setup()   { _A_SETUP="$1"; }
agent_launch()  { _A_LAUNCH="$1"; }
agent_daemon()  { _A_DAEMON="$1"; }

# Classify a GitHub credential by its prefix. Only fine-grained PATs are bound
# to one owner with explicit per-repo permissions; the rest are account-wide.
token_kind() {
    case "${1:-}" in
        github_pat_*) echo "fine-grained" ;;
        ghp_*)        echo "classic" ;;
        gho_*)        echo "oauth" ;;
        ghu_*)        echo "oauth-user" ;;
        ghs_*)        echo "app-installation" ;;
        ghr_*)        echo "refresh" ;;
        "")           echo "none" ;;
        *)            echo "unknown" ;;
    esac
}
token_is_narrow() { [ "$(token_kind "${1:-}")" = "fine-grained" ]; }

# Known projects = those with a config, plus any existing VM (config-less ones).
project_list() {
    { ls "$PROJECTS"/*.conf 2>/dev/null | sed 's|.*/||; s|\.conf$||'
      limactl list -q 2>/dev/null | sed -n -e "s|^${PREFIX}||p" -e "s|^${LEGACY_PREFIX}||p"
    } | sort -u
}
agent_exists() { [ -n "${1:-}" ] && [ -f "$AGENTS/$1.conf" ]; }
agent_list()   { ls "$AGENTS"/*.conf 2>/dev/null | sed 's|.*/||; s|\.conf$||' || true; }
load_agent() {
    _A_DESC=""; _A_BIN=""; _A_PATHS=""; _A_INSTALL=""; _A_SETUP=""; _A_LAUNCH=""; _A_DAEMON=""
    agent_exists "$1" || die "unknown agent '$1' (see: sandbox agents)"
    source "$AGENTS/$1.conf"
    [ -n "$_A_BIN" ]    || die "agents/$1.conf: agent_bin is required"
    [ -n "$_A_LAUNCH" ] || die "agents/$1.conf: agent_launch is required"
}

# PATH prelude for a loaded agent, expanded inside the VM.
agent_prelude() { local p out=""; for p in $_A_PATHS; do out="${out}export PATH=\"$p:\$PATH\"; "; done; printf '%s' "$out"; }
agent_installed() { vm bash -lc "$(agent_prelude)command -v $_A_BIN >/dev/null 2>&1" </dev/null >/dev/null 2>&1; }

# Install on first use, so VMs created before an agent existed still get it —
# a Lima template edit would only ever reach *new* VMs.
ensure_agent() {
    local name="$1"
    load_agent "$name"
    agent_installed && return 0
    [ -n "$_A_INSTALL" ] || die "agent '$name' is not installed and agents/$name.conf has no agent_install"
    echo ">> installing agent '$name' in $INST (first use, one time)..."
    vm bash -lc "$_A_INSTALL" </dev/null || die "install failed for agent '$name'"
    if [ -n "$_A_SETUP" ]; then
        vm bash -lc "$(agent_prelude)$_A_SETUP" </dev/null || die "post-install setup failed for agent '$name'"
    fi
    # Register the agent's PATH for every login shell, so `shell`, `exec` and
    # remote IDEs see it too — not just the launcher.
    if [ -n "$_A_PATHS" ]; then
        printf '%s\n' "$(agent_prelude)" \
            | vm bash -lc "set -e; t=\"\$(mktemp)\"; cat > \"\$t\"; sudo install -m 0644 -o root -g root \"\$t\" /etc/profile.d/sandbox-agent-$name.sh; rm -f \"\$t\""
    fi
    agent_installed || die "agent '$name' still not on PATH after install"
    echo ">> agent '$name' ready."
}

run_agent() { # $1=agent, rest = args passed through to it
    local name="$1"; shift
    ensure_agent "$name"
    # Forward the host terminal's identity so the agent's TUI applies the right
    # key handling (Shift/Alt+Enter, truecolor); SSH strips these vars.
    local envargs=()
    if [ -n "${TERM_PROGRAM:-}" ];         then envargs+=("TERM_PROGRAM=$TERM_PROGRAM"); fi
    if [ -n "${TERM_PROGRAM_VERSION:-}" ]; then envargs+=("TERM_PROGRAM_VERSION=$TERM_PROGRAM_VERSION"); fi
    if [ -n "${COLORTERM:-}" ];            then envargs+=("COLORTERM=$COLORTERM"); fi
    vm_login \
        env ${envargs[@]+"${envargs[@]}"} \
        bash -lc "$(agent_prelude)cd ~/workspace 2>/dev/null || cd ~; $_A_LAUNCH" _ "$@"
}

# ----------------------------------------------------------- background daemons
# An agent may declare `agent_daemon '<command>'`: a long-running server that
# should be up whenever the VM is, with no terminal attached. The motivating
# case is `claude remote-control` — drive the sandbox from claude.ai/code or the
# phone without keeping a `sandbox <project>` terminal open. It is installed as
# a systemd *user* unit with lingering enabled, so it starts with the VM and
# survives you disconnecting from it.
#
# Which daemons a project runs comes from `use_daemon <agent>` in its config
# (repeatable); unset means "this project's own agent, if it declares one", and
# `use_daemon none` turns them off.
daemon_unit()   { printf 'sandbox-%s.service' "$1"; }
daemon_script() { printf '.config/sandbox/daemon-%s.sh' "$1"; }
sha256()        { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi | cut -d' ' -f1; }

agents_with_daemon() {
    local a
    for a in $(agent_list); do
        load_agent "$a"
        if [ -n "$_A_DAEMON" ]; then printf '%s\n' "$a"; fi
    done
}

project_daemons() {   # echo the agents whose daemon this project wants
    load_project "$PROJECT"
    local a out="" want=()
    read -ra want <<<"${_DAEMONS:-${_AGENT:-$DEFAULT_AGENT}}"   # split, don't glob
    for a in ${want[@]+"${want[@]}"}; do
        [ "$a" != none ] || return 0
        agent_exists "$a" || die "use_daemon: unknown agent '$a' (see: sandbox agents)"
        load_agent "$a"
        if [ -n "$_A_DAEMON" ]; then out="$out $a"; fi
    done
    printf '%s' "${out# }"
}

# The wrapper the unit runs, as a file in the VM rather than an inline
# ExecStart=: systemd's quoting rules are not the shell's, and this way the
# exact command is inspectable — and runnable by hand — inside the VM. `-l` so
# it gets the same login environment an interactive agent would (toolchain PATH,
# the pinned GH_TOKEN, IS_SANDBOX).
daemon_script_body() {   # $1 = agent name (already loaded)
    cat <<EOF
#!/bin/bash -l
# Generated by the sandbox launcher for project '$PROJECT' — overwritten on the
# next 'sandbox $PROJECT up'. Run by systemd as $(daemon_unit "$1").
set -u
$(agent_prelude)
cd "\$HOME/workspace" 2>/dev/null || cd "\$HOME"
$_A_DAEMON
EOF
}

daemon_unit_body() {   # $1 = agent name (already loaded), $2 = content hash
    cat <<EOF
[Unit]
Description=sandbox daemon: $1 ($PROJECT)
After=network-online.target
Wants=network-online.target
# Give up after ~10 failures in 10 minutes instead of crash-looping forever (an
# agent that was never logged in fails every time); 'daemon restart' un-wedges.
StartLimitIntervalSec=600
StartLimitBurst=10
# sandbox-config: $2

[Service]
Type=simple
ExecStart=%h/$(daemon_script "$1")
Restart=always
RestartSec=15
Environment=SANDBOX_PROJECT=$PROJECT
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
EOF
}

# Idempotent: rewrites the wrapper and the unit, but only restarts a daemon that
# is already up if what it runs actually changed — the hash in the unit covers
# both files, so `up` on a live VM never drops a connected remote session.
install_daemon() {   # $1 = agent name; assumes the VM is up
    local name="$1" hash
    ensure_agent "$name"          # installs it on first use; also load_agent's it
    [ -n "$_A_DAEMON" ] || die "agent '$name' declares no agent_daemon"
    hash="$( { daemon_script_body "$name"; daemon_unit_body "$name" ""; } | sha256 )"

    daemon_script_body "$name" | vm env S="$(daemon_script "$name")" bash -lc '
        set -e; umask 077
        mkdir -p "$(dirname "$HOME/$S")"
        cat > "$HOME/$S.new"
        chmod 0755 "$HOME/$S.new"
        mv "$HOME/$S.new" "$HOME/$S"' || die "could not install the daemon wrapper for '$name'"

    daemon_unit_body "$name" "$hash" | vm env U="$(daemon_unit "$name")" bash -lc '
        set -e
        # Lingering, or the user manager — and the daemon with it — is torn down
        # when the last session ends, and only returns at the next login.
        sudo loginctl enable-linger "$USER" >/dev/null
        export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        mkdir -p ~/.config/systemd/user
        f=~/.config/systemd/user/"$U"
        cat > "$f.new"
        changed=1; if cmp -s "$f.new" "$f" 2>/dev/null; then changed=0; fi
        mv "$f.new" "$f"
        systemctl --user daemon-reload
        systemctl --user enable "$U" >/dev/null 2>&1
        if [ "$changed" = 1 ]; then systemctl --user restart "$U"; else systemctl --user start "$U"; fi' \
        || die "systemd refused the '$name' daemon (see: sandbox $PROJECT daemon status $name)"
}

daemon_one_line() { printf '%s' "$1" | tr '\n' ' ' | sed 's/\\ */ /g; s/  */ /g'; }

daemon_state() {   # $1 = agent -> "<enabled>/<active>", or why not
    vm env U="$(daemon_unit "$1")" bash -lc '
        [ -f ~/.config/systemd/user/"$U" ] || { echo "not installed"; exit 0; }
        export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        printf "%s/%s\n" "$(systemctl --user is-enabled "$U" 2>&1)" \
                         "$(systemctl --user is-active  "$U" 2>&1)"' </dev/null 2>/dev/null \
        || echo unknown
}

daemon_ctl() {   # $1 = agent, rest = systemctl verbs
    local name="$1"; shift
    vm env U="$(daemon_unit "$name")" bash -lc '
        export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        exec systemctl --user "$@" "$U"' _ "$@" </dev/null
}

# A daemon captures its environment when it starts — including the pinned
# GH_TOKEN — so a rotated token only reaches it across a restart. Only bounces
# what is actually running.
refresh_daemons() {
    local d ds
    ds="$(project_daemons)" || return 0
    for d in ${ds:-}; do
        if daemon_ctl "$d" is-active >/dev/null 2>&1; then
            daemon_ctl "$d" restart >/dev/null 2>&1 || true
            echo ">> daemon '$d' restarted so it picks up the new credentials"
        fi
    done
    return 0
}

# Run when the launcher brings the VM up. Non-fatal by construction: a daemon
# that will not start must never stand between you and a shell — hence the
# subshell, since install_daemon can die().
ensure_daemons() {
    local d ds
    ds="$(project_daemons)" || return 0
    [ -n "$ds" ] || return 0
    local st
    for d in $ds; do
        if ( install_daemon "$d" ); then
            st="$(daemon_state "$d")"
            echo ">> daemon '$d': $st   (logs: sandbox $PROJECT daemon logs $d)"
            case "$st" in
                */active) ;;
                *) echo "   not up — usually means the agent was never logged in here:"
                   echo "   run 'sandbox $PROJECT $d', /login, then 'sandbox $PROJECT daemon restart'" ;;
            esac
        else
            echo "   !! daemon '$d' did not start — see: sandbox $PROJECT daemon status $d"
        fi
    done
    return 0
}

# --------------------------------------------------------------- VM lifecycle
exists()  { limactl list -q 2>/dev/null | grep -qx "$INST"; }

# The VM for a project: ai-sandbox-<project>, or the claude-<project> it was
# called before the rename, as long as that one hasn't been migrated. Existing
# VMs keep working under the old name; `sandbox <project> migrate` renames one.
inst_for() {
    local vms; vms="$(limactl list -q 2>/dev/null || true)"
    if ! grep -qx "${PREFIX}$1" <<<"$vms" && grep -qx "${LEGACY_PREFIX}$1" <<<"$vms"; then
        echo "${LEGACY_PREFIX}$1"
    else
        echo "${PREFIX}$1"
    fi
}
running() { [ "$(limactl list "$INST" --format '{{.Status}}' 2>/dev/null)" = "Running" ]; }
vm()      { limactl shell "$INST" "$@"; }   # run a program in the VM

shquote() {   # single-quote each argument, for a command line the remote shell re-parses
    local out="" a
    for a in "$@"; do out+=" '${a//\'/\'\\\'\'}'"; done
    printf '%s' "${out# }"
}

# Interactive sessions get their own ssh connection instead of `limactl shell`,
# so that GUI apps in the VM can open windows on the Mac. Two things make that
# necessary: limactl offers no way to ask for X11 forwarding, and it holds a
# shared master connection (ControlMaster) that a later `ssh -Y` silently rides
# — inheriting the master's *lack* of forwarding, so the -Y looks like it worked
# and $DISPLAY stays empty in the VM. Hence ControlPath=none: one connection per
# session, an extra TCP handshake, and windows that actually open.
#
# -Y is *trusted* forwarding (see "Isolation & security" in the README). It is
# requested only when the Mac has a DISPLAY, so a host without XQuartz keeps
# exactly the old behaviour.
vm_login() {   # exec an interactive session in the VM; args (optional) = remote argv
    local cfg="${LIMA_HOME:-$HOME/.lima}/$INST/ssh.config"
    if [ -f "$cfg" ]; then
        local opts=(-F "$cfg" -o ControlMaster=no -o ControlPath=none)
        if [ -n "${DISPLAY:-}" ]; then opts+=(-Y); fi
        if [ -t 0 ]; then opts+=(-t); fi     # ssh gives a command no tty by default
        if [ $# -gt 0 ]; then
            exec ssh "${opts[@]}" "lima-$INST" "$(shquote "$@")"
        fi
        exec ssh "${opts[@]}" "lima-$INST"
    fi
    # Lima too old to write ssh.config, or an instance directory we can't find:
    # no GUI windows, but everything else works as before.
    exec limactl shell "$INST" "$@"
}

_VM_COLD=0     # did *this* invocation start the VM?
ensure_up() {
    _VM_COLD=0
    if ! exists; then
        echo ">> creating VM '$INST' (first run provisions toolchains — a few minutes)..."
        limactl start --name "$INST" --tty=false "$TEMPLATE"
        configure_identities   # auto-apply project auth on first create
        _VM_COLD=1
    elif ! running; then
        limactl start "$INST"
        _VM_COLD=1
    fi
    # Background daemons are *enabled* systemd units, so once installed they
    # come up with the VM on their own — no need to poke them on every command.
    # Installing them here is what makes them appear on a VM that predates them.
    if [ "$_VM_COLD" = 1 ]; then ensure_daemons; fi
}

configure_identities() { # assumes VM is up
    load_project "$PROJECT"
    if [ -z "$(printf '%s' "$_IDENTITIES" | tr -d ' \t\n')" ]; then
        echo ">> no identities in $PROJECTS/$PROJECT.conf — run: sandbox new $PROJECT"
        return 0
    fi
    # Pass 1 — resolve every token on the host BEFORE touching the VM. The reset
    # below is destructive, so discovering a missing Keychain item afterwards
    # would leave the VM with no working credentials at all: worse than the stale
    # ones we set out to clear.
    local users=() names=() emails=() hosts=() tokens=() oscopes=() kcs=() n=0
    while IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes; do
        [ -n "$ghuser" ] || continue
        local token=""
        if ! token="$(secret_get "$kc")"; then
            # The first configured identity is the primary; without it there is
            # no git identity, no active gh account and no signing key owner.
            [ "$n" -gt 0 ] || die "primary identity $ghuser: Keychain item $(kc_service "$kc") not found — run: sandbox secret set $kc (nothing in the VM was changed)"
            echo "   !! skipping $ghuser: Keychain item $(kc_service "$kc") not found (sandbox secret set $kc)"
            continue
        fi
        users[$n]="$ghuser"; names[$n]="$gname";  emails[$n]="$gemail"
        hosts[$n]="$ghost";  tokens[$n]="$token"; oscopes[$n]="$scopes"; kcs[$n]="$kc"
        n=$((n+1))
    done <<EOF
$_IDENTITIES
EOF
    [ "$n" -gt 0 ] || die "no usable identities for '$PROJECT'"

    # Pass 2 — install the per-scope credential helper (root-owned, staged
    # through a private temp file rather than a predictable path), then reset
    # *both* token stores. Dropping gh's hosts.yml matters: without it, an
    # identity removed from the config — or a rotated token — keeps working
    # inside the VM forever.
    vm bash -lc 'set -e; t="$(mktemp)"; cat > "$t"; sudo install -m 0755 -o root -g root "$t" /usr/local/bin/git-credential-sandbox; rm -f "$t"' < "$HELPER_SRC"
    vm bash -lc 'rm -f ~/.config/gh/hosts.yml; mkdir -p ~/.config/sandbox && chmod 700 ~/.config/sandbox && : > ~/.config/sandbox/credentials && chmod 600 ~/.config/sandbox/credentials' </dev/null

    local i=0 scope scope_list
    while [ "$i" -lt "$n" ]; do
        echo ">> [${users[$i]}@${hosts[$i]}] gh auth + git credentials"
        if ! token_is_narrow "${tokens[$i]}"; then
            echo "   !! WIDE TOKEN: '${kcs[$i]}' is a $(token_kind "${tokens[$i]}") token, not a fine-grained PAT."
            echo "      It grants this VM broad access to your account. Prefer a fine-grained"
            echo "      PAT scoped to this project's repos.  Details: sandbox $PROJECT audit"
        fi
        if ! printf '%s' "${tokens[$i]}" | vm env GH_HOST="${hosts[$i]}" bash -lc 'gh auth login --hostname "$GH_HOST" --with-token' 2>/dev/null; then
            echo "   !! gh auth login failed for ${users[$i]} (token valid? needs repo/read:org)"
        fi
        scope_list=()
        read -ra scope_list <<<"${oscopes[$i]}"   # split on whitespace, no globbing
        for scope in ${scope_list[@]+"${scope_list[@]}"}; do
            printf '%s\t%s\n' "$scope" "${tokens[$i]}" | vm bash -lc 'cat >> ~/.config/sandbox/credentials'
        done
        i=$((i+1))
    done

    # The primary is the first *configured* identity, never whichever one
    # happened to resolve first.
    if [ -n "${names[0]}" ];  then vm git config --global user.name  "${names[0]}"  </dev/null; fi
    if [ -n "${emails[0]}" ]; then vm git config --global user.email "${emails[0]}" </dev/null; fi
    vm env GH_HOST="${hosts[0]}" PRIMARY="${users[0]}" bash -lc '
        git config --global credential.useHttpPath true
        git config --global --replace-all credential.helper "sandbox"
        gh auth setup-git --hostname "$GH_HOST" 2>/dev/null || true
        gh auth switch --hostname "$GH_HOST" --user "$PRIMARY" 2>/dev/null || true
    ' </dev/null

    # Pin gh to the project's PAT via GH_TOKEN: the env var outranks
    # ~/.config/gh/hosts.yml, so a stray `gh auth login` (wide OAuth token)
    # cannot take effect. Only for single-identity projects — with several
    # identities gh must stay switchable between accounts.
    if [ "$n" = 1 ]; then
        printf '%s' "${tokens[0]}" | vm bash -lc \
            'umask 077; mkdir -p ~/.config/sandbox; cat > ~/.config/sandbox/gh-token'
        vm bash -lc 'sudo tee /etc/profile.d/ai-sandbox-gh.sh >/dev/null' <<'EOF'
# ai-sandbox: pin gh to this project's PAT. GH_TOKEN outranks the token
# stored by `gh auth login`, so an accidental wide/OAuth login can't take over.
[ -r "$HOME/.config/sandbox/gh-token" ] && export GH_TOKEN="$(cat "$HOME/.config/sandbox/gh-token")"
EOF
        echo ">> gh pinned to the project PAT (GH_TOKEN) — a stray 'gh auth login' won't take effect"
    else
        vm bash -lc 'sudo rm -f /etc/profile.d/ai-sandbox-gh.sh; rm -f ~/.config/sandbox/gh-token' </dev/null
        echo ">> multiple identities — gh left switchable (GH_TOKEN not pinned)"
    fi
    echo ">> identities applied for '$PROJECT' (primary: ${users[0]})"
}

# ------------------------------------------------------------ credential audit
# Which GitHub credential this project holds — in the host Keychain and, if the
# VM is running, live inside it. Read-only.
audit_project() {
    local ghuser gname gemail ghost kc scopes t k mark
    echo "project: $PROJECT   VM: $INST"
    echo "--- configured tokens (host Keychain) ---"
    load_project "$PROJECT"
    if [ -z "$(printf '%s' "$_IDENTITIES" | tr -d ' \t\n')" ]; then
        echo "  (no identities in $PROJECTS/$PROJECT.conf)"
    else
        while IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes; do
            [ -n "$ghuser" ] || continue
            if t="$(secret_get "$kc")"; then k="$(token_kind "$t")"; else k="MISSING from Keychain"; fi
            case "$k" in
                fine-grained) mark="ok  " ;;
                "MISSING"*)   mark="??  " ;;
                *)            mark="WIDE" ;;
            esac
            printf '  [%s] %-28s %s  (%s)\n' "$mark" "$kc" "$k" "$ghuser@$ghost"
        done <<EOF
$_IDENTITIES
EOF
    fi
    echo "--- live credential in the VM ---"
    if ! running; then
        echo "  (VM not running — start it with: sandbox $PROJECT up)"
        return 0
    fi
    vm bash -l -s <<'EOF'
tok="$(gh auth token 2>/dev/null)"
case "$tok" in
  github_pat_*) kind="fine-grained (limited)" ;;
  ghp_*)        kind="CLASSIC PAT (account-wide, scope-based)" ;;
  gho_*|ghu_*)  kind="OAUTH (full account access!)" ;;
  ghs_*)        kind="app installation" ;;
  "")           kind="none — gh not authenticated" ;;
  *)            kind="unknown" ;;
esac
echo "  gh token        : ${tok:0:12}...  -> $kind"
echo "  source          : $(gh auth status 2>&1 | grep -qi 'GH_TOKEN\|environment' && echo 'GH_TOKEN env (pinned)' || echo '~/.config/gh/hosts.yml')"
echo "  GH_TOKEN pinned : $([ -n "${GH_TOKEN:-}" ] && echo yes || echo no)"
scopes="$(gh api -i user 2>/dev/null | sed -nE 's/^[Xx]-[Oo]auth-[Ss]copes: *//p' | tr -d '\r')"
echo "  oauth scopes    : ${scopes:-(none — fine-grained PAT)}"
echo "  gh account      : $(gh api user --jq .login 2>/dev/null || echo unknown)"
echo "  git identity    : $(git config --global user.name) <$(git config --global user.email)>"
echo "  credential helper: $(git config --global credential.helper)"
echo "  scoped creds    : $(wc -l < ~/.config/sandbox/credentials 2>/dev/null || echo 0) org route(s)"
EOF
}

# ------------------------------------------------------------ token rotation
# Every *other* project whose config references Keychain item $1: they read the
# same token, so a new value only reaches their VMs after their own `auth`.
kc_other_projects() {
    local kc="$1" p real
    for p in $(project_list); do
        [ "$p" != "$PROJECT" ] && [ -f "$PROJECTS/$p.conf" ] || continue
        real="$(conf_path "$PROJECTS/$p.conf" 2>/dev/null)" || continue
        if conf_kc_list "$real" 2>/dev/null | grep -qxF -- "$kc"; then printf '%s\n' "$p"; fi
    done
}

# `sandbox <project> secret [<ghuser|keychain-name>]` — replace one identity's
# token (typically an expired PAT) under the Keychain name the config already
# uses, then re-apply it to the VM and show the audit. The config is never
# touched: the name stays, only the value behind it changes.
rotate_secret() {
    [ $# -le 1 ] || die "usage: sandbox $PROJECT secret [<github-user|keychain-name>]"
    local sel="${1:-}" ghuser gname gemail ghost kc scopes t k i=0 pick others target
    local -a users=() kcs=()
    load_project "$PROJECT"
    while IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes; do
        [ -n "$ghuser" ] || continue
        users[$i]="$ghuser@$ghost"; kcs[$i]="$kc"; i=$((i+1))
    done <<EOF
$_IDENTITIES
EOF
    [ "$i" -gt 0 ] || die "no identities in $PROJECTS/$PROJECT.conf — run: sandbox new $PROJECT"

    pick=""
    if [ -n "$sel" ]; then
        i=0
        while [ "$i" -lt "${#kcs[@]}" ]; do
            case "$sel" in
                "${kcs[$i]}"|"${users[$i]}"|"${users[$i]%@*}") pick="$i"; break ;;
            esac
            i=$((i+1))
        done
        [ -n "$pick" ] || die "'$sel' is neither a GitHub user nor a Keychain name in $PROJECTS/$PROJECT.conf
  identities: $(i=0; while [ "$i" -lt "${#kcs[@]}" ]; do printf '%s (%s)  ' "${users[$i]}" "${kcs[$i]}"; i=$((i+1)); done)"
    elif [ "${#kcs[@]}" = 1 ]; then
        pick=0
    else
        echo "identities in '$PROJECT':"
        i=0
        while [ "$i" -lt "${#kcs[@]}" ]; do
            if t="$(secret_get "${kcs[$i]}")"; then k="$(token_kind "$t")"; else k="missing"; fi
            printf '  %d) %-28s %-24s %s\n' "$((i+1))" "${users[$i]}" "${kcs[$i]}" "$k"
            i=$((i+1))
        done
        pick="$(ask "Which token to replace (1-${#kcs[@]})")"
        [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "${#kcs[@]}" ] \
            || die "no such identity: '$pick'"
        pick=$((pick-1))
    fi
    # Not `kc`: configure_identities reads into an undeclared `kc`, which would
    # overwrite ours through bash's dynamic scoping.
    target="${kcs[$pick]}"

    if t="$(secret_get "$target")"; then k="$(token_kind "$t")"; else k="not stored yet"; fi
    echo ">> replacing the token for ${users[$pick]}  (Keychain: $(kc_service "$target"), currently: $k)"
    echo "   Prefer a fine-grained PAT (github_pat_...) scoped to this project's repos."
    secret_set "$target"

    if exists; then
        ensure_up             # starts a stopped VM: the point is to apply the token now
        configure_identities  # warns if the new token is wide
        refresh_daemons
        echo
        audit_project
    else
        echo ">> no VM '$INST' yet — the token is applied when it is created: sandbox $PROJECT up"
    fi

    others="$(kc_other_projects "$target" | tr '\n' ' ')"
    if [ -n "$others" ]; then
        echo ">> '$target' is shared with: ${others% } — re-apply there too:  sandbox <project> auth"
    fi
}

# ---------------------------------------------------- GPG commit signing key
setup_keys() { # assumes VM is up; uses the primary identity
    load_project "$PROJECT"
    local rec; rec="$(primary_record)"
    [ -n "$rec" ] || die "no identities in $PROJECTS/$PROJECT.conf — run: sandbox new $PROJECT"
    local ghuser gname gemail ghost kc scopes
    IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes <<<"$rec"
    [ -n "$gname" ]  || gname="$ghuser"
    [ -n "$gemail" ] || die "primary identity has no --git-email; GPG signing needs one"

    echo ">> [$ghuser@$ghost] GPG signing key in $INST"
    local keyid
    keyid="$(vm env GNAME="$gname" EMAIL="$gemail" bash -s < "$ROOT/lima/setup-keys.sh")"
    [ -n "$keyid" ] || die "key setup failed in the VM"
    echo "   GPG signing key: $keyid  (commits + tags will be signed)"

    # GitHub matches GPG keys by fingerprint and ignores a re-upload of a key it
    # already stores — including the renewed expiry — so the stored copy has to
    # be deleted first for a renewal to take effect. Removing it is safe for
    # history: per GitHub's docs, commits already verified stay verified after
    # the public key is removed.
    local upload
    upload="$(vm env GH_HOST="$ghost" KEYID="$keyid" bash -lc '
        old=$(gh api user/gpg_keys --jq ".[] | select(.key_id==env.KEYID) | .id" 2>/dev/null | head -1)
        if [ -n "$old" ]; then
            gh api -X DELETE "user/gpg_keys/$old" >/dev/null 2>&1 || { echo replace-denied; exit 0; }
        fi
        if gpg --armor --export "$KEYID" | gh gpg-key add - >/dev/null 2>&1; then
            if [ -n "$old" ]; then echo renewed; else echo added; fi
        else
            if [ -n "$old" ]; then echo lost; else echo denied; fi
        fi' </dev/null 2>/dev/null || echo denied)"
    case "$upload" in
        added)   echo "   uploaded GPG signing key to $ghost" ;;
        renewed) echo "   replaced the stored key on $ghost so the new expiry takes effect" ;;
        lost)    echo "   !! removed the old key from $ghost but could not upload the new one —"
                 echo "      add it now, or commits will show Unverified:" ;;
        replace-denied)
                 echo "   !! $ghost already stores this key and it could not be replaced, so any"
                 echo "      renewed expiry has NOT taken effect there (the token needs 'GPG keys'"
                 echo "      write permission). Delete the old key and add this one:" ;;
        *)       echo "   !! gh could not add the GPG key (token lacks 'GPG keys' write permission)" ;;
    esac
    case "$upload" in
        added|renewed) ;;
        *) echo ">> add it manually at https://$ghost/settings/gpg/new :"
           vm env KEYID="$keyid" bash -lc 'gpg --armor --export "$KEYID"' </dev/null ;;
    esac

    printf ">> test — local GPG-signed commit: "
    vm bash -lc 'T=$(mktemp -d); cd "$T"; git init -q; git commit -q --allow-empty -m t; \
        git log --show-signature -1 2>&1 | grep -qi "good signature" && echo OK || echo FAILED; \
        cd /; rm -rf "$T"' </dev/null

    printf ">> verify — key registered on %s (via PAT): " "$ghost"
    vm env GH_HOST="$ghost" KEYID="$keyid" EMAIL="$gemail" PROJ="$PROJECT" bash -lc '
        if gh api user/gpg_keys --jq ".[].key_id" 2>/dev/null | grep -qx "$KEYID"; then
            echo "yes — commits by <$EMAIL> will show Verified (if that email is verified on the account)"
        else
            echo "no — add the key above, then re-run: sandbox $PROJ keys"
        fi' </dev/null
    # The key lives in a VM an untrusted agent can read, so it is deliberately
    # short-lived: an exfiltrated key stops being able to forge signatures.
    # (setup-keys.sh reports the expiry date on stderr as it sets it.)
    echo "   renew the signing key any time with:  sandbox $PROJECT keys"
}

# ----------------------------------------------------------------- new wizard
# A failed read means EOF (^D / no tty): give up instead of re-prompting forever.
ask()    { local p="$1" d="${2:-}" a; read -rp "$p${d:+ [$d]}: " a || { echo >&2; die "cancelled"; }; printf '%s' "${a:-$d}"; }
confirm(){ local a; read -rp "$1 [$2]: " a; a="${a:-$2}"; [[ "$a" =~ ^[Yy] ]]; }

new_project() {
    mkdir -p "$PROJECTS"
    local proj conf default="${1:-}"
    while :; do
        proj="$(ask 'Project name' "$default")"; default=""
        [ -n "$proj" ] || { echo "  a name is required." >&2; continue; }
        valid_ident "$proj" || { echo "  invalid name — use letters, digits, '.', '_', '-'." >&2; continue; }
        conf="$PROJECTS/$proj.conf"
        [ -f "$conf" ] && { echo "  '$proj' already exists ($conf) — pick another name, or run: sandbox $proj auth" >&2; continue; }
        break
    done

    echo "New project '$proj'. Config saved to $conf; tokens go to the Keychain."
    echo
    local ghuser gname gemail kc
    while :; do
        ghuser="$(ask 'Primary GitHub username')"
        [ -n "$ghuser" ] || die "username required"      # also breaks the loop on EOF
        valid_ghuser "$ghuser" && break
        echo "  not a valid GitHub username." >&2
    done
    while :; do
        gname="$(ask 'Git commit name' "$ghuser")"
        valid_text "$gname" && break
        echo "  the name cannot be empty or contain control characters." >&2
    done
    while :; do
        gemail="$(ask 'Git commit email')"
        [ -n "$gemail" ] || die "commit email required"   # also breaks the loop on EOF
        valid_email "$gemail" && break
        echo "  not a valid email address." >&2
    done
    echo "Create a fine-grained PAT (Contents + Pull requests; add 'GPG keys' for auto signing-key upload):"
    echo "  https://github.com/settings/personal-access-tokens/new"
    kc="$proj-$ghuser"
    echo "Token for $ghuser — 'security' will prompt for it (hidden, never on the command line)."
    secret_put "$kc"
    # Every value is single-quoted: this file is `source`d as shell code.
    {
        echo "# $proj — generated by 'sandbox new' on $(date +%Y-%m-%d)"
        echo "add_identity \\"
        echo "  --github-username $(shq "$ghuser") \\"
        echo "  --git-name        $(shq "$gname") \\"
        echo "  --git-email       $(shq "$gemail") \\"
        echo "  --token-keychain  $(shq "$kc")"
    } > "$conf"
    chmod 600 "$conf"

    while confirm "Add another identity for a specific org?" "N"; do
        local xuser xscope xkc
        xuser="$(ask '  GitHub username')"
        if ! valid_ghuser "$xuser"; then echo "  not a valid GitHub username, skipping." >&2; continue; fi
        xscope="$(ask '  Org scope (host/org, e.g. github.com/some-org)')"
        if ! valid_scope "$xscope"; then echo "  not a valid <host>/<org>[/...] scope, skipping." >&2; continue; fi
        xkc="$proj-$xuser"
        echo "  Token for $xuser — 'security' will prompt for it (hidden)."
        secret_put "$xkc"
        { echo; echo "add_identity \\"; echo "  --github-username $(shq "$xuser") \\";
          echo "  --token-keychain  $(shq "$xkc") \\"; echo "  --org-scope       $(shq "$xscope")"; } >> "$conf"
    done

    local agent
    echo; echo "Agents available: $(agent_list | tr '\n' ' ')"
    while :; do
        agent="$(ask 'Default agent' "$DEFAULT_AGENT")"
        agent_exists "$agent" && break
        echo "  unknown agent '$agent' — pick one of: $(agent_list | tr '\n' ' ')" >&2
    done
    { echo; echo "# agent opened by a bare 'sandbox $proj'"; echo "use_agent $agent"; } >> "$conf"

    # Background daemon — on by default when the agent declares one: the point
    # of it is to outlive the terminal you started the VM from.
    load_agent "$agent"
    if [ -n "$_A_DAEMON" ]; then
        echo
        echo "Remote control: keep '$agent' running inside the VM with nothing attached,"
        echo "so you can drive '$proj' from claude.ai/code or the Claude app. It can reach"
        echo "everything in the VM, including this project's tokens and signing key."
        if confirm "Enable it?" "Y"; then
            { echo; echo "# daemon kept running whenever the VM is up"; echo "use_daemon $agent"; } >> "$conf"
        else
            { echo; echo "# no background daemon for this project"; echo "use_daemon none"; } >> "$conf"
        fi
    fi

    echo; echo "Wrote $conf"
    PROJECT="$proj"; INST="$(inst_for "$proj")"
    confirm "Create and provision the VM now (~5-10 min)?" "Y" || { echo "Later: sandbox $proj up"; return 0; }
    ensure_up
    confirm "Generate GPG signing key and add to GitHub?" "Y" && setup_keys
    # Pre-warm so the first launch isn't waiting on a download. Subshell: a failed
    # install shouldn't abort the wizard after the VM and keys are already set up.
    ( ensure_agent "$agent" ) || echo ">> agent install failed — retry with: sandbox $proj agent install $agent"
    echo; echo ">> '$proj' ready.  Run:  sandbox $proj"
}

# ---------------------------------------------------------------- rename
# Lima has no `rename`, so the instance is cloned under the new name and the old
# one deleted. `limactl clone` reflinks the disk on APFS (instant, no second
# copy) and never leaves a half-moved instance behind; the directory move is the
# fallback for Lima versions that predate it.
rename_vm() {
    local from="$1" to="$2" clone_args=()
    if limactl clone --help >/dev/null 2>&1; then
        # Newer Lima drops into $EDITOR for the new instance unless told not to.
        if limactl clone --help 2>&1 | grep -q -- '--tty'; then clone_args+=(--tty=false); fi
        echo ">> renaming VM $from -> $to (clone + delete)..."
        limactl clone ${clone_args[@]+"${clone_args[@]}"} "$from" "$to" \
            || die "clone failed — '$from' is untouched"
        limactl delete -f "$from" \
            || echo "   !! '$to' is ready but '$from' could not be deleted — remove it with: limactl delete -f $from"
    else
        local lima_home="${LIMA_HOME:-$HOME/.lima}"
        [ -d "$lima_home/$from" ] || die "no instance directory $lima_home/$from"
        [ ! -e "$lima_home/$to" ] || die "$lima_home/$to already exists"
        echo ">> renaming VM $from -> $to (moving $lima_home/$from)..."
        mv "$lima_home/$from" "$lima_home/$to" || die "could not move the instance directory"
        rm -f "$lima_home/$to/ssh.config"   # names the old host; Lima rewrites it on start
    fi
    echo "   (the guest's own hostname still says $from until the VM is re-created)"
}

# Copy a Keychain item to a new name. `security -i` reads its commands from
# stdin, so the token stays out of argv — the same reason secret_put has
# `security` prompt for it rather than passing it as an argument.
kc_copy() {
    local from="$1" to="$2" val
    val="$(secret_get "$from")" || return 1
    # The interactive parser splits on whitespace and strips quotes, so anything
    # outside this set would arrive mangled: leave it where it is. A leading '-'
    # is excluded too — it would be read as an option, leaving -w without a
    # value, and `security` would then prompt on the tty with its output sent to
    # /dev/null: an invisible hang.
    [[ "$val" =~ ^[A-Za-z0-9_.+=/][A-Za-z0-9_.+=/-]*$ ]] || return 1
    printf 'add-generic-password -U -s %s -a %s -w %s\n' \
        "$(kc_service "$to")" "$USER" "$val" | security -i >/dev/null 2>&1 || return 1
    [ "$(secret_get "$to" || true)" = "$val" ]
}

# The --token-keychain of every identity a config declares, one per line, or
# non-zero if the file no longer parses. Sourcing it is how the launcher reads a
# config everywhere else; this just asks what the result actually says.
conf_kc_list() {
    ( set -e
      _IDENTITIES=""; _AGENT=""
      # shellcheck source=/dev/null
      source "$1" >/dev/null
      printf '%s' "$_IDENTITIES" | while IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes; do
          [ -n "$ghuser" ] || continue
          printf '%s\n' "$kc"
      done )
}

# Repoint one --token-keychain value in a config. Keychain names are validated
# idents, so '.' is the only regex metacharacter that can occur.
conf_rewrite_kc() {
    local file="$1" okc="$2" nkc="$3" re tmp
    re="${okc//./\\.}"
    tmp="$(mktemp)"
    sed -e "s/\(--token-keychain[[:space:]][[:space:]]*\)'$re'/\1'$nkc'/g" \
        -e "s/\(--token-keychain[[:space:]][[:space:]]*\)\"$re\"/\1\"$nkc\"/g" \
        -e "s/\(--token-keychain[[:space:]][[:space:]]*\)$re\([[:space:]]\)/\1$nkc\2/g" \
        -e "s/\(--token-keychain[[:space:]][[:space:]]*\)$re\$/\1$nkc/g" \
        "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    # Check what the rewritten file *declares*, not what it looks like: the
    # patterns above cannot cover every hand-written form (a value continued
    # onto the next line, say), and the old Keychain item is deleted right after
    # this returns — a rewrite that quietly did nothing would strand the project
    # on a token that no longer exists. Refusing here leaves both alone instead.
    local decl
    decl="$(conf_kc_list "$tmp")" || { rm -f "$tmp"; return 1; }   # must still parse
    if printf '%s\n' "$decl" | grep -qxF -- "$okc"; then rm -f "$tmp"; return 1; fi
    printf '%s\n' "$decl" | grep -qxF -- "$nkc" || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$file" || { rm -f "$tmp"; return 1; }   # atomic, as set-email does
    chmod 600 "$file"
}

# `sandbox new` names Keychain items "<project>-<ghuser>", so a rename leaves
# them carrying the old project's name. Copy each under the new prefix, repoint
# the config, then drop the old copy — in that order, so an interruption always
# leaves the config pointing at a token that exists.
rename_secrets() {
    local old="$1" new="$2" conf="$3" real nkc other f k seen i=0 j=0
    local -a from=() to=()
    # conf_path dies inside the command substitution, which only kills the
    # subshell: without this the Keychain step would be skipped silently and the
    # rename would still report success.
    if ! real="$(conf_path "$conf")"; then
        echo "   !! could not read $conf — its Keychain items keep the '$old-' names"
        return 1
    fi
    _IDENTITIES=""; _AGENT=""
    # shellcheck source=/dev/null
    source "$real"
    while IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes; do
        [ -n "$kc" ] || continue
        case "$kc" in "$old-"*) ;; *) continue ;; esac
        nkc="$new-${kc#"$old-"}"
        valid_ident "$nkc" || continue
        secret_get "$kc" >/dev/null 2>&1 || continue      # nothing stored under it
        if secret_get "$nkc" >/dev/null 2>&1; then
            echo "   !! $(kc_service "$nkc") already exists — keeping $kc"
            continue
        fi
        # A token shared with another project has to keep its name there.
        other=0
        for f in "$PROJECTS"/*.conf; do
            [ -f "$f" ] || continue
            [ "$f" = "$PROJECTS/$new.conf" ] && continue
            if grep -qE -- "--token-keychain[[:space:]]+['\"]?${kc//./\\.}['\"]?([[:space:]]|\$)" "$f" 2>/dev/null; then
                other=1; break
            fi
        done
        if [ "$other" = 1 ]; then
            echo "   !! $kc is also referenced by $f — keeping its name"
            continue
        fi
        seen=0
        for k in ${from[@]+"${from[@]}"}; do
            if [ "$k" = "$kc" ]; then seen=1; break; fi   # shared by two identities
        done
        [ "$seen" = 0 ] || continue
        from+=("$kc"); to+=("$nkc")
    done <<EOF
$_IDENTITIES
EOF
    [ "${#from[@]}" -gt 0 ] || return 0

    echo ">> Keychain items still named after '$old':"
    while [ "$i" -lt "${#from[@]}" ]; do printf '     %s -> %s\n' "${from[$i]}" "${to[$i]}"; i=$((i+1)); done
    confirm "Rename them too (the config is repointed for you)?" "Y" || {
        echo "   left alone — '$new' keeps using the '$old-' Keychain names"
        return 0
    }
    # Copy every one before touching anything: a partial migration would leave
    # some identities pointing at names that were never created.
    i=0
    while [ "$i" -lt "${#from[@]}" ]; do
        if ! kc_copy "${from[$i]}" "${to[$i]}"; then
            echo "   !! could not copy ${from[$i]} -> ${to[$i]} — leaving every Keychain item as it is"
            # -le, not -lt: kc_copy may have created to[i] and failed only
            # at the verification that follows it.
            while [ "$j" -le "$i" ]; do secret_rm "${to[$j]}" >/dev/null 2>&1 || true; j=$((j+1)); done
            return 0
        fi
        i=$((i+1))
    done
    i=0
    while [ "$i" -lt "${#from[@]}" ]; do
        if conf_rewrite_kc "$real" "${from[$i]}" "${to[$i]}"; then
            secret_rm "${from[$i]}" >/dev/null 2>&1 \
                || echo "   !! kept the old item — remove it with: sandbox secret rm ${from[$i]}"
            echo "   $(kc_service "${from[$i]}") -> $(kc_service "${to[$i]}")"
        else
            echo "   !! could not repoint $real at ${to[$i]} — edit its --token-keychain by hand"
            secret_rm "${to[$i]}" >/dev/null 2>&1 || true
        fi
        i=$((i+1))
    done
}

rename_project() { # $1 = the new name for $PROJECT
    local old="$PROJECT" new="${1:-}"
    [ $# -le 1 ] || die "usage: sandbox $old rename <new-name>"
    [ -n "$new" ] || die "usage: sandbox $old rename <new-name>"
    valid_ident "$new" || die "invalid project name '$new' — use letters, digits, '.', '_', '-'"
    ! is_toplevel "$new" || die "'$new' is a sandbox command — 'sandbox $new ...' would never reach the project"
    [ "$new" != "$old" ] || die "'$old' is already called that"
    local oconf="$PROJECTS/$old.conf" nconf="$PROJECTS/$new.conf" ninst="${PREFIX}$new"
    if [ -e "$nconf" ] || [ -L "$nconf" ]; then   # -L too: -e is false for a dangling link
        die "$nconf already exists — pick another name"
    fi
    local vm; for vm in "$ninst" "${LEGACY_PREFIX}$new"; do
        ! limactl list -q 2>/dev/null | grep -qx "$vm" || die "a VM named '$vm' already exists — pick another name"
    done

    # The VM goes first: it is the step that can fail, and a config renamed
    # ahead of it would be left describing a project with no VM.
    if exists; then
        if running; then
            echo "!! '$INST' is running — it has to be stopped to be renamed."
            confirm "Stop it now?" "Y" || die "aborted — nothing was changed"
            limactl stop "$INST"
        fi
        rename_vm "$INST" "$ninst"
    else
        echo ">> no VM '$INST' — renaming the config only"
    fi

    if [ -f "$oconf" ]; then
        # `mv` moves a symlink itself, so a config linked out of a dotfiles
        # checkout keeps pointing at the same file under its new name.
        mv "$oconf" "$nconf" \
            || die "the VM is now '$ninst' but $oconf could not be renamed — move it to $nconf by hand"
        echo ">> config: $oconf -> $nconf"
        rename_secrets "$old" "$new" "$nconf" || true
    else
        echo ">> no config $oconf — nothing else to rename"
    fi

    PROJECT="$new"; INST="$ninst"      # so anything below sees the renamed project
    # A daemon's unit carries SANDBOX_PROJECT (the remote-control session is
    # named after it), and the VM is stopped here, so the next start rewrites it
    # under the new name on its own — but say so, since until then the session
    # on claude.ai still shows the old one.
    if [ -n "$(project_daemons 2>/dev/null || true)" ]; then
        echo ">> its daemons still announce 'sandbox-$old' — the next start re-installs them as 'sandbox-$new'"
    fi
    echo ">> '$old' is now '$new'.  Run:  sandbox $new"
}

# ---------------------------------------------------------------- sessions
# Claude Code keeps each conversation in the VM as
# ~/.claude/projects/<cwd, '/' -> '-'>/<id>.jsonl, plus optional <id>/
# (subagent transcripts), file-history/<id> (/rewind) and todos/<id>-*.json.
# Nothing is shared between VMs, so moving a session means streaming those
# files from one VM to the other through the host. The in-VM scripts run under
# plain `bash -c`, not a login shell, so nothing a profile prints can end up
# inside the tar stream; values reach them through env, never the command line.

session_ls() {
    echo "Claude sessions in $INST, newest first:"
    vm python3 - <<'PY'
import glob, json, os, time
root = os.path.expanduser("~/.claude/projects")
if not os.path.isdir(root):
    print("  (no Claude sessions in this VM)"); raise SystemExit
os.chdir(root)
def first_prompt(path):
    try:
        with open(path) as f:
            for line in f:
                try: e = json.loads(line)
                except ValueError: continue
                if e.get("type") != "user": continue
                c = (e.get("message") or {}).get("content")
                if isinstance(c, list):
                    c = " ".join(p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") == "text")
                if isinstance(c, str) and c.strip() and not c.lstrip().startswith("<"):
                    return " ".join(c.split())[:60]
    except OSError: pass
    return ""
files = sorted(glob.glob("*/*.jsonl"), key=os.path.getmtime, reverse=True)
if not files: print("  (no Claude sessions in this VM)")
for f in files:
    d, name = f.split("/", 1)
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(f)))
    print(f"  {name[:-6]}  {when}  {d}\n      {first_prompt(f)}")
PY
}

# Resolve <id|id-prefix|--all> in this VM: _S_PATHS gets the paths (relative to
# ~/.claude) that make it up, one per line; _S_ID the full id (empty for --all).
session_paths() {
    local what="$1" all=0 list
    if [ "$what" = "--all" ]; then all=1
    else [[ "$what" =~ ^[0-9a-f-]{4,36}$ ]] || die "not a session id: '$what' (see: sandbox $PROJECT session ls)"
    fi
    list="$(vm env ALL="$all" ID="$what" bash -c '
        cd ~/.claude 2>/dev/null || exit 0
        shopt -s nullglob
        if [ "$ALL" = 1 ]; then
            for p in projects file-history todos; do [ -e "$p" ] && echo "$p"; done
            exit 0
        fi
        m=(projects/*/"$ID"*.jsonl)
        [ ${#m[@]} -eq 1 ] || { echo "!${#m[@]}"; exit 0; }
        f="${m[0]}"; id="$(basename "$f" .jsonl)"
        echo "$f"
        for p in "${f%.jsonl}" "file-history/$id" todos/"$id"-*; do [ -e "$p" ] && echo "$p"; done
        exit 0')" || die "could not read sessions in $INST"
    case "$list" in
        "")   die "no Claude sessions in $INST" ;;
        "!0") die "no session '$what' in $INST (see: sandbox $PROJECT session ls)" ;;
        "!"*) die "'$what' matches ${list#!} sessions in $INST — give more of the id" ;;
    esac
    _S_PATHS="$list"; _S_ID=""
    [ "$all" = 1 ] || _S_ID="$(basename "$(printf '%s\n' "$list" | head -1)" .jsonl)"
}

# An export is a plain tar of those paths, plus sandbox-export.txt recording the
# source VM's $HOME: session folders are named after the working directory, so
# an import into a VM with a different HOME (another Mac, another username)
# renames them to match. Everything but the tar itself goes to stderr, so
# `export ... -` can feed a pipe.
session_export() { # <id|--all> [file|-]
    local what="${1:-}" out="${2:-}"
    [ $# -ge 1 ] && [ $# -le 2 ] && [ -n "$what" ] \
        || die "usage: sandbox $PROJECT session export <session-id|--all> [file|-]"
    ensure_up >&2
    session_paths "$what"
    if [ -z "$out" ]; then
        if [ -n "$_S_ID" ]; then out="claude-session-$PROJECT-${_S_ID:0:8}.tar"
        else out="claude-sessions-$PROJECT.tar"; fi
    fi
    if [ "$out" = "-" ]; then
        [ ! -t 1 ] || die "refusing to write a tar archive to the terminal — pipe it, or give a file name"
    else
        [ ! -e "$out" ] || die "$out already exists"
    fi
    {
        if [ -n "$_S_ID" ]; then echo ">> exporting session $_S_ID from $INST"
        else echo ">> exporting all $(printf '%s\n' "$_S_PATHS" | wc -l | tr -d ' ') session folder(s) from $INST"; fi
        # The VM is a project boundary; a transcript is everything that crossed it.
        echo "   A transcript holds every tool output, including any token or file it showed —"
        echo "   whoever imports it sees what '$PROJECT' saw."
    } >&2
    confirm "Continue?" "Y" || die "aborted — nothing was exported"

    local stream='t="$(mktemp -d)"; trap "rm -rf \"$t\"" EXIT
        printf "home=%s\n" "$HOME" > "$t/sandbox-export.txt"
        printf "%s\n" "$LIST" | tar -cf - -C "$t" sandbox-export.txt -C "$HOME/.claude" -T -'
    if [ "$out" = "-" ]; then
        vm env LIST="$_S_PATHS" bash -c "$stream" || die "export failed"
    else
        # Transcripts can hold secrets: owner-only, and never a half-written file.
        ( umask 077; vm env LIST="$_S_PATHS" bash -c "$stream" > "$out.part" ) \
            || { rm -f "$out.part"; die "export failed"; }
        mv "$out.part" "$out"
        echo ">> wrote $out — on the other machine:  sandbox <project> session import $out" >&2
    fi
}

# Only session files are accepted — nothing outside projects/, file-history/
# and todos/, no '..', no links — and nothing already in the VM is overwritten.
session_import() { # <file|-> [--no-register]
    local in="" register=1 a
    for a in "$@"; do
        case "$a" in
            --no-register) register=0 ;;
            *) [ -z "$in" ] || die "usage: sandbox $PROJECT session import <file|-> [--no-register]"
               in="$a" ;;
        esac
    done
    [ -n "$in" ] || die "usage: sandbox $PROJECT session import <file|-> [--no-register]"
    exists || die "no VM '$INST' — create it first: sandbox $PROJECT up"
    local src="$in" tmp=""
    if [ "$in" = "-" ]; then
        [ ! -t 0 ] || die "stdin is a terminal — pipe an export in, or give a file name"
        tmp="$(mktemp)"; src="$tmp"
        cat > "$tmp" || { rm -f "$tmp"; die "could not read stdin"; }
    else
        [ -f "$in" ] || die "no such file: $in"
    fi
    [ -s "$src" ] || { rm -f "$tmp"; die "nothing to import (empty input)"; }
    local names types n bad=""
    names="$(tar -tf "$src" 2>/dev/null)" || { rm -f "$tmp"; die "not a tar archive: $in"; }
    while IFS= read -r n; do
        case "$n" in
            sandbox-export.txt|projects|projects/*|file-history|file-history/*|todos|todos/*) ;;
            *) bad="unexpected path '$n'"; break ;;
        esac
        case "/$n/" in */../*) bad="'..' in '$n'"; break ;; esac
    done <<<"$names"
    # ls-style listing: first column is the type — only files and directories.
    types="$(tar -tvf "$src" | cut -c1 | sort -u | tr -d '\n')"
    case "$types" in *[!-d]*) [ -n "$bad" ] || bad="links or special files" ;; esac
    [ -z "$bad" ] || { rm -f "$tmp"; die "not a session export ($bad) — nothing imported"; }

    ensure_up
    local ids
    ids="$(vm bash -c '
        set -e
        s="$(mktemp -d)"; trap "rm -rf \"$s\"" EXIT
        tar -C "$s" -xf - --no-same-owner
        src="$(sed -n "s/^home=//p" "$s/sandbox-export.txt" 2>/dev/null || true)"
        rm -f "$s/sandbox-export.txt"
        enc() { printf "%s" "$1" | sed "s/[^A-Za-z0-9]/-/g"; }
        if [ -n "$src" ] && [ "$src" != "$HOME" ] && [ -d "$s/projects" ]; then
            from="$(enc "$src")"; to="$(enc "$HOME")"
            for d in "$s/projects/"*; do
                b="${d##*/}"
                case "$b" in "$from"|"$from"-*) ;; *) continue ;; esac
                nb="$to${b#"$from"}"
                if [ -e "$s/projects/$nb" ]; then echo "   !! $b and $nb both present — left $b as is" >&2; continue; fi
                mv "$d" "$s/projects/$nb"
                echo "   re-homed $b -> $nb ($src -> $HOME)" >&2
            done
        fi
        mkdir -p ~/.claude
        (cd "$s" && tar -cf - .) | tar -C ~/.claude -xf - --skip-old-files
        cd "$s" && ls projects/*/*.jsonl 2>/dev/null | sed "s|.*/||; s|\.jsonl$||" || true' < "$src")" \
        || { rm -f "$tmp"; die "import into $INST failed"; }
    rm -f "$tmp"
    n="$(printf '%s' "$ids" | grep -c . || true)"
    echo ">> imported $n session(s) into $INST (anything already there was left as it is)"
    echo "   (only the conversation moved — the code it worked on is not part of it)"
    [ "$n" -gt 0 ] || return 0
    if [ "$register" = 1 ]; then
        # shellcheck disable=SC2086  # one id per word, by construction
        session_register $ids
    else
        echo "   to list them in the agent view:  sandbox $PROJECT session register --all"
    fi
}

# The agent view (`claude agents`) lists the background-session daemon's jobs,
# not transcripts, so an imported conversation only shows up there once it is
# resumed in the background — by hand: `claude --resume`, pick it, press ←.
# `claude --bg --resume <id>` does the same in one step and sends nothing to the
# model. Each session is started from the directory it was recorded in (its home
# prefix re-mapped to this VM's), then stopped again unless --running: an idle
# background session holds a few hundred MB, and a whole export's worth would
# not fit in the VM. Sessions already in the agent view are left alone.
session_register() { # <session-id...|--all> [--running]
    local running=0 ids=() a
    for a in "$@"; do
        case "$a" in
            --running) running=1 ;;
            --all)     ids+=(--all) ;;
            *) [[ "$a" =~ ^[0-9a-f-]{4,36}$ ]] || die "not a session id: '$a' (see: sandbox $PROJECT session ls)"
               ids+=("$a") ;;
        esac
    done
    [ ${#ids[@]} -gt 0 ] || die "usage: sandbox $PROJECT session register <session-id...|--all> [--running]"
    ensure_up
    echo ">> adding sessions to the agent view in $INST (one background start each — takes a moment)"
    if [ "$running" = 1 ]; then
        echo "   leaving them running idle: each holds a few hundred MB until stopped (claude stop <id>)"
    fi
    vm env IDS="${ids[*]}" RUNNING="$running" PROJECT="$PROJECT" python3 - <<'PY' || die "some sessions could not be added — see above"
import glob, json, os, re, shutil, subprocess, sys
home = os.path.expanduser("~")
want = os.environ.get("IDS", "").split()
running = os.environ.get("RUNNING") == "1"
claude = shutil.which("claude", path=os.path.join(home, ".local/bin") + os.pathsep + os.environ.get("PATH", ""))
if not claude:
    print("   !! Claude Code is not installed in this VM (sandbox <project> agent install claude)"); sys.exit(1)
ansi = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
def run(args, cwd=None):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=180)
    return r.returncode, ansi.sub("", r.stdout), ansi.sub("", r.stderr)
def last_line(*texts):
    lines = [l.strip() for t in texts for l in t.splitlines() if l.strip()]
    return lines[-1] if lines else "no output"

rc, out, err = run([claude, "agents", "--json", "--all"])
try:
    known = {a.get("sessionId") for a in json.loads(out)}
except ValueError:
    print("   !! could not read the agent view (claude agents --json): " + last_line(out, err)); sys.exit(1)

files = {os.path.basename(f)[:-len(".jsonl")]: f for f in glob.glob(os.path.join(home, ".claude/projects/*/*.jsonl"))}
bad = 0
if "--all" in want:
    ids = sorted(files, key=lambda i: os.path.getmtime(files[i]))   # oldest first: newest ends on top
else:
    ids = []
    for w in want:
        m = [i for i in files if i.startswith(w)]
        if len(m) == 1: ids.append(m[0])
        else: print(f"   !! {w}: " + ("no such session" if not m else f"matches {len(m)} sessions — give more of the id")); bad += 1

def recorded_cwd(path):
    with open(path, errors="replace") as fh:
        for line in fh:
            try: c = json.loads(line).get("cwd")
            except (ValueError, AttributeError): continue
            if isinstance(c, str) and c: return c
    return None

added = skipped = 0
for sid in ids:
    if sid in known:
        print(f"   = {sid[:8]}  already in the agent view"); skipped += 1; continue
    cwd = recorded_cwd(files[sid])
    if not cwd:
        print(f"   - {sid[:8]}  no working directory recorded (an empty session?)"); skipped += 1; continue
    if not os.path.isdir(cwd):
        # Exported from a VM with another $HOME: same path under this one.
        m = re.match(r"^/(home|Users)/[^/]+", cwd)
        alt = home + cwd[m.end():] if m else None
        if alt and os.path.isdir(alt):
            cwd = alt
        else:
            print(f"   - {sid[:8]}  {alt or cwd} does not exist here — create it (clone the repo, re-add the worktree) and re-run")
            skipped += 1; continue
    rc, out, err = run([claude, "--bg", "--resume", sid, "--dangerously-skip-permissions"], cwd=cwd)
    if rc != 0:
        print(f"   !! {sid[:8]}  {last_line(out, err)}"); bad += 1; continue
    m = re.search(r"backgrounded\W+([0-9a-f]{6,})", out + err)
    job = m.group(1) if m else sid[:8]
    # A background job is named after the first 8 characters of its session id;
    # if one by that name exists, Claude starts a copy under a new id.
    note = f"  (as a copy, {job}: another job already uses {sid[:8]})" if "a copy" in out + err else ""
    note += "  (running)" if running else ""
    if not running:
        rc, out, err = run([claude, "stop", job])
        if rc != 0: note += f"  (added, but still running: {last_line(out, err)})"
    print(f"   + {sid[:8]}  {cwd}{note}"); added += 1
print(f">> {added} added to the agent view, {skipped} skipped" + (f", {bad} failed" if bad else ""))
if added: print(f">> open them from the agent view:  sandbox {os.environ.get('PROJECT', '<project>')}")
sys.exit(1 if bad else 0)
PY
}

# Same machine: export straight into the other project's import.
session_copy() { # <id|id-prefix|--all> <dest-project>
    local what="${1:-}" dest="${2:-}"
    [ $# -eq 2 ] && [ -n "$what" ] && [ -n "$dest" ] \
        || die "usage: sandbox $PROJECT session copy <session-id|--all> <other-project>"
    valid_ident "$dest" || die "invalid project name: $dest"
    [ "$dest" != "$PROJECT" ] || die "'$dest' is this project"
    local dinst; dinst="$(inst_for "$dest")"
    limactl list -q 2>/dev/null | grep -qx "$dinst" || die "no VM for '$dest' ($dinst) — create it first: sandbox $dest up"
    session_export "$what" - | ( PROJECT="$dest"; INST="$dinst"; session_import - )
}

# ---------------------------------------------------------------- migrate
# claude-<project> -> ai-sandbox-<project>. Only the VM's name changes: the
# config, Keychain items and everything inside the VM stay as they are.
migrate_project() {
    local ninst="${PREFIX}$PROJECT"
    if [ "$INST" = "$ninst" ]; then
        if exists; then echo ">> '$INST' already uses the current name"; else echo ">> no VM for '$PROJECT' — nothing to migrate"; fi
        # Both names taken: the old VM is shadowed, and nothing here deletes a VM for you.
        if limactl list -q 2>/dev/null | grep -qx "${LEGACY_PREFIX}$PROJECT"; then
            echo "   !! '${LEGACY_PREFIX}$PROJECT' also exists and is no longer used — inspect it, then: limactl delete ${LEGACY_PREFIX}$PROJECT"
        fi
        return 0
    fi
    exists || die "no VM '$INST' to migrate"
    if running; then
        echo "!! '$INST' is running — it has to be stopped to be renamed (attached sessions end)."
        confirm "Stop it now?" "Y" || die "aborted — nothing was changed"
        limactl stop "$INST"
    fi
    rename_vm "$INST" "$ninst"
    INST="$ninst"
    echo ">> '$PROJECT' now runs in '$INST'. VS Code / ssh / scp: the host is now lima-$INST"
}

# ------------------------------------------------------------------- dispatch
case "${1:-}" in
    ""|-h|--help|help) usage; exit 0 ;;
    new) new_project "${2:-}"; exit 0 ;;
    ls|list)
        echo "sandbox VMs:"
        limactl list 2>/dev/null | awk -v p="^${PREFIX}" -v l="^${LEGACY_PREFIX}" 'NR==1 || $1 ~ p || $1 ~ l' || true
        legacy=""
        for p in $(limactl list -q 2>/dev/null | sed -n "s|^${LEGACY_PREFIX}||p"); do
            [ "$(inst_for "$p")" = "${LEGACY_PREFIX}$p" ] && legacy+="$p "
        done
        [ -z "$legacy" ] || echo ">> old-style ${LEGACY_PREFIX}* names: ${legacy% } — rename with: sandbox <project> migrate"
        exit 0 ;;
    agents)
        echo "agents (agents/*.conf, default: $DEFAULT_AGENT):"
        for a in $(agent_list); do
            load_agent "$a"
            printf '  %-12s %s\n' "$a" "$_A_DESC"
            is_builtin "$a" && echo "               !! name collides with a command — reach it via: sandbox <project> agent run $a"
        done
        echo
        echo "per-VM install status:  sandbox <project> agent"
        exit 0 ;;
    secret)
        sub="${2:-}"; name="${3:-}"
        [ -n "$name" ] || die "usage: sandbox secret set|rm <name>"
        valid_ident "$name" || die "invalid secret name: $name"
        case "$sub" in
            set) secret_set "$name" ;;
            rm|remove|delete) secret_rm "$name" ;;
            *) die "usage: sandbox secret set|rm <name>" ;;
        esac
        exit 0 ;;
esac

PROJECT="$1"; shift || true
valid_ident "$PROJECT" || die "invalid project name: $PROJECT"
INST="$(inst_for "$PROJECT")"
CMD="${1:-$(project_agent "$PROJECT")}"; shift || true

# Typo guard: never provision a VM for a project we've never heard of. A project
# is known if it has a config or an existing VM. ('config' is exempt so it can
# still report what's missing; 'sandbox new' creates projects.)
case "$CMD" in
    config|conf) ;;
    *) if [ ! -f "$PROJECTS/$PROJECT.conf" ] && ! exists; then
           die "unknown project '$PROJECT' — no config ($PROJECTS/$PROJECT.conf) and no VM '$INST'
  known projects: $(project_list | tr '\n' ' ')
  create it with:  sandbox new $PROJECT"
       fi ;;
esac

case "$CMD" in
    up|start) ensure_up
              if [ "$_VM_COLD" = 0 ]; then ensure_daemons; fi   # already running: reconcile
              echo ">> $INST running." ;;
    auth)     ensure_up; configure_identities; refresh_daemons ;;
    secret|token) rotate_secret "$@" ;;
    keys)     ensure_up; setup_keys ;;
    set-email|email)
        new_email="${1:-}"
        [ -n "$new_email" ] || die "usage: sandbox $PROJECT set-email <email>"
        valid_email "$new_email" || die "not a valid email: $new_email"
        conf="$PROJECTS/$PROJECT.conf"
        [ -f "$conf" ] || die "no config $conf — run: sandbox new $PROJECT"
        # Rewrite the real file, so a config symlinked from a dotfiles checkout
        # keeps its symlink instead of being replaced by a regular file.
        conf="$(conf_path "$conf")" || exit 1
        # Rewrite the primary identity's --git-email (first occurrence). The
        # replacement is single-quoted (the file is shell code) and '&' / '\'
        # are escaped so awk cannot expand them into the matched text.
        tmp="$(mktemp)"
        awk -v new="$(shq "$new_email")" '
            BEGIN { gsub(/[\\&]/, "\\\\&", new) }
            !done && /--git-email[[:space:]]+[^[:space:]]+/ { sub(/--git-email[[:space:]]+[^[:space:]]+/, "--git-email " new); done=1 }
            { print }
            END { if (!done) exit 3 }' "$conf" > "$tmp" \
            || { rm -f "$tmp"; die "primary identity has no --git-email line in $conf; add one and retry"; }
        mv "$tmp" "$conf" || { rm -f "$tmp"; die "could not update $conf"; }  # atomic: never leave
        chmod 600 "$conf"                                                     # a half-written config
        echo ">> git email set to $new_email in $conf"
        ensure_up
        setup_keys   # regenerates the GPG signing key for the new email + re-points signing
        ;;
    rename|mv)
        rename_project "$@" ;;
    migrate)
        [ $# -eq 0 ] || die "usage: sandbox $PROJECT migrate"
        migrate_project ;;
    session|sessions)
        sub="${1:-ls}"; shift || true
        case "$sub" in
            ls|list) [ $# -eq 0 ] || die "usage: sandbox $PROJECT session ls"
                     ensure_up; session_ls ;;
            copy|cp) session_copy "$@" ;;
            export)  session_export "$@" ;;
            import)  session_import "$@" ;;
            register) session_register "$@" ;;
            *) die "usage: sandbox $PROJECT session [ls] | copy <session-id|--all> <other-project> | export <session-id|--all> [file|-] | import <file|-> [--no-register] | register <session-id...|--all> [--running]" ;;
        esac ;;
    shell)    ensure_up; vm_login ;;
    code)     ensure_up
              command -v code >/dev/null 2>&1 || die "VS Code 'code' CLI not on PATH (install it / enable 'code' command)"
              ide_home="$(limactl shell "$INST" printenv HOME 2>/dev/null)"
              exec code --remote "ssh-remote+lima-${INST}" "${ide_home:-/home/$USER}/${1:-workspace}" ;;
    agent)
        sub="${1:-ls}"; shift || true
        case "$sub" in
            ls|list)
                ensure_up
                echo "agents in '$INST' (default: $(project_agent "$PROJECT")):"
                for a in $(agent_list); do
                    load_agent "$a"
                    if agent_installed; then st="installed"; else st="not installed"; fi
                    printf '  %-12s %-14s %s\n' "$a" "$st" "$_A_DESC"
                done ;;
            install)
                [ $# -gt 0 ] || die "usage: sandbox $PROJECT agent install <name>"
                ensure_up; ensure_agent "$1" ;;
            default|use)
                new_agent="${1:-}"
                [ -n "$new_agent" ] || die "usage: sandbox $PROJECT agent default <name>"
                agent_exists "$new_agent" || die "unknown agent '$new_agent' (see: sandbox agents)"
                conf="$PROJECTS/$PROJECT.conf"
                [ -f "$conf" ] || die "no config $conf — run: sandbox new $PROJECT"
                conf="$(conf_path "$conf")" || exit 1   # vet + follow symlinks, as set-email does
                tmp="$(mktemp)"
                awk -v a="$new_agent" '
                    /^[[:space:]]*use_agent[[:space:]]/ { if (!done) { print "use_agent " a; done=1 } next }
                    { print }
                    END { if (!done) { print ""; print "use_agent " a } }' "$conf" > "$tmp"
                mv "$tmp" "$conf" || { rm -f "$tmp"; die "could not update $conf"; }
                chmod 600 "$conf"
                echo ">> default agent for '$PROJECT' is now '$new_agent' ($conf)" ;;
            run)
                [ $# -gt 0 ] || die "usage: sandbox $PROJECT agent run <name> [args...]"
                agent_run_name="$1"; shift
                ensure_up; run_agent "$agent_run_name" "$@" ;;
            *) die "usage: sandbox $PROJECT agent [ls|install <name>|default <name>|run <name> ...]" ;;
        esac ;;
    daemon|daemons)
        sub="${1:-ls}"; if [ $# -gt 0 ]; then shift; fi
        case "$sub" in
            ls|list|status|logs|start|stop|restart|install|off) ;;
            *) die "usage: sandbox $PROJECT daemon [ls|status|logs [-f]|start|stop|restart|install|off] [agent]" ;;
        esac
        dfollow=""; dnames=""
        for a in ${@+"$@"}; do
            case "$a" in
                -f|--follow) dfollow="-f" ;;
                -*) die "sandbox $PROJECT daemon $sub: unknown option '$a'" ;;
                *)  agent_exists "$a" || die "unknown agent '$a' (see: sandbox agents)"
                    dnames="$dnames $a" ;;
            esac
        done
        dnames="${dnames# }"
        [ -n "$dnames" ] || dnames="$(project_daemons)"
        [ -n "$dnames" ] || die "'$PROJECT' runs no background daemon (its agent declares none, or the config says 'use_daemon none')
  agents that declare one: $(agents_with_daemon | tr '\n' ' ')
  turn one on with:  sandbox $PROJECT config --edit   # add: use_daemon <agent>"
        ensure_up
        case "$sub" in ls|list) echo "background daemons for '$PROJECT' in $INST:" ;; esac
        for d in $dnames; do
            case "$sub" in
                ls|list)  load_agent "$d"
                          printf '  %-10s %-18s %s\n' "$d" "$(daemon_state "$d")" "$(daemon_one_line "$_A_DAEMON")" ;;
                install)  install_daemon "$d"; echo ">> daemon '$d': $(daemon_state "$d")" ;;
                status)   daemon_ctl "$d" status --no-pager || true ;;
                start|stop|restart)
                          daemon_ctl "$d" "$sub"; echo ">> daemon '$d': $(daemon_state "$d")" ;;
                off)      daemon_ctl "$d" disable --now || true
                          echo ">> daemon '$d' stopped and disabled — it will not return with the VM
   (put 'use_daemon none' in the config to keep 'up' from switching it back on)" ;;
                logs)     exec limactl shell "$INST" env U="$(daemon_unit "$d")" F="$dfollow" bash -lc '
                              export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
                              exec journalctl --user -u "$U" -n 200 --no-pager ${F:+$F}' ;;
            esac
        done ;;
    exec)     ensure_up; [ $# -gt 0 ] || die "exec needs a command"
              if [ $# -eq 1 ]; then
                  exec limactl shell "$INST" bash -lc "$1"                  # documented: exec 'go test ./...'
              else
                  exec limactl shell "$INST" bash -lc 'exec "$@"' _ "$@"    # keep each argument intact
              fi ;;
    stop)     limactl stop "$INST" ;;
    destroy|delete)
        exists || die "no VM '$INST' to destroy"
        echo "!! '$INST' and everything in it (code, tokens, GPG signing key) will be permanently deleted — this cannot be undone."
        printf "   Type the project name '%s' to confirm: " "$PROJECT"
        read -r ans || true
        [ "$ans" = "$PROJECT" ] || die "aborted — name did not match"
        limactl delete -f "$INST"; echo ">> $INST deleted." ;;
    status)   limactl list "$INST" 2>/dev/null || echo "(no VM '$INST')" ;;
    audit)    audit_project ;;
    config|conf)
        cfg="$PROJECTS/$PROJECT.conf"
        case "${1:-}" in
            -e|--edit)
                [ -f "$cfg" ] || die "no config at $cfg — create it with: sandbox new $PROJECT"
                exec "${EDITOR:-vi}" "$cfg" ;;
            -p|--path) echo "$cfg"; exit 0 ;;
        esac
        echo "config: $cfg"
        if [ ! -f "$cfg" ]; then
            echo "status: MISSING — '$PROJECT' runs unconfigured (no gh auth, git identity or GPG signing)"
            echo "        create it with:  sandbox new $PROJECT"
            exit 1
        fi
        echo "status: present"
        load_project "$PROJECT"
        echo "agent:  ${_AGENT:-$DEFAULT_AGENT}$([ -n "$_AGENT" ] || echo '  (default)')"
        if [ -z "$(printf '%s' "$_IDENTITIES" | tr -d ' \t\n')" ]; then
            echo "identities: none declared"
        else
            echo "identities (first = primary):"
            while IFS="$_IFS_REC" read -r ghuser gname gemail ghost kc scopes; do
                [ -n "$ghuser" ] || continue
                if secret_get "$kc" >/dev/null 2>&1; then tok="ok"; else tok="MISSING — sandbox secret set $kc"; fi
                printf '  %s@%s\n' "$ghuser" "$ghost"
                printf '    git:   %s <%s>\n' "${gname:-—}" "${gemail:-—}"
                printf '    token: %s  [keychain: %s]\n' "$kc" "$tok"
                if [ -n "$(printf '%s' "$scopes" | tr -d ' ')" ]; then printf '    orgs: %s\n' "$scopes"; fi
            done <<EOF
$_IDENTITIES
EOF
        fi ;;
    # Not a command — try the agent registry. Commands are matched first, so an
    # agent can never shadow one; `agent run <name>` reaches it either way.
    *) agent_exists "$CMD" || die "unknown command or agent '$CMD' (commands: shell, code, agent, config, audit, up, auth, keys, set-email, rename, exec, status, stop, destroy; agents: $(agent_list | tr '\n' ' '))"
       ensure_up; run_agent "$CMD" "$@" ;;
esac
